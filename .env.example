# CyberFate 环境变量配置示例
# 复制此文件为 .env.local 并填入真实值
# 生成 NEXTAUTH_SECRET: openssl rand -base64 32

# ── 数据库 ────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/cyberfate
# Vercel Postgres / Prisma (可选，覆盖 DATABASE_URL)
POSTGRES_PRISMA_DATABASE_URL=postgresql://user:password@localhost:5432/cyberfate

# ── NextAuth ─────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# ── AI (DeepSeek) ────────────────────────────────────
# Provider「modelverse」（网关）— 兜底
DEEPSEEK_API_KEY=your_deepseek_api_key_here
# AI_BASE_URL=https://api-sg.umodelverse.ai/v1   # modelverse 网关入口（默认）
# AI_PRIMARY_MODEL=deepseek-v4-pro               # 两个 provider 模型名一致
# AI_FALLBACK_MODEL=deepseek-v4-flash

# Provider「deepseek-official」（官方直连）— 主
DEEPSEEK_OFFICIAL_API_KEY=your_deepseek_official_api_key_here
# DEEPSEEK_OFFICIAL_BASE_URL=https://api.deepseek.com   # 默认

# 运行时默认激活的 provider（可被后台 /admin 开关覆盖）：deepseek-official | modelverse
LLM_DEFAULT_PROVIDER=deepseek-official

# ── Redis / Upstash KV ───────────────────────────────
# Vercel KV 集成（优先使用）
KV_REST_API_URL=https://your-kv.upstash.io
KV_REST_API_TOKEN=your_kv_rest_api_token
# 或使用标准 Upstash 变量名
# UPSTASH_REDIS_REST_URL=https://your-kv.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token
# 原始 Redis URL（备用）
# REDIS_URL=rediss://default:token@host:6379

# ── Stripe 支付 ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ── 邮件 (Resend) ─────────────────────────────────────
RESEND_API_KEY=re_your_resend_api_key

# ── OAuth ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ── 微信小程序 ────────────────────────────────────────
WECHAT_APP_ID=your_wechat_app_id
WECHAT_APP_SECRET=your_wechat_app_secret

# ── 管理员 ────────────────────────────────────────────
# 逗号分隔的管理员邮箱列表
ADMIN_EMAILS=admin@example.com

# ── 安全 (内部回调) ──────────────────────────────────
CALLBACK_SECRET=your_internal_callback_secret
