// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?

  // 微信登录
  wechatOpenId  String? @unique
  wechatUnionId String?

  // 用户信息
  nickname String?
  avatar   String?

  // 出生信息（用于命理计算）
  birthDate String? // YYYY-MM-DD
  birthHour String? // 时辰 "-1" to "11"
  gender    String? // male/female

  // 时间戳
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  passwordChangedAt DateTime?

  // 关联
  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  orders        Order[]
  usageQuotas   UsageQuota[]

  @@map("users")
}

// NextAuth Account 表（OAuth 账号关联）
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session 表
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth 验证 Token
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// 订阅计划类型
enum SubscriptionPlan {
  daily
  yearly
  lifetime
}

// 订阅状态
enum SubscriptionStatus {
  active
  expired
  cancelled
}

// 订阅表
model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  plan               SubscriptionPlan
  status             SubscriptionStatus @default(active)
  startAt            DateTime           @default(now())
  expireAt           DateTime
  autoRenew          Boolean            @default(false)
  cancelAtPeriodEnd  Boolean            @default(false)
  pendingPlan        SubscriptionPlan?
  pendingPlanDate    DateTime?
  paymentMethod      PayMethod?
  paymentMethodLast4 String?
  cancelFeedback     String?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expireAt])
  @@index([userId, createdAt])
  @@map("subscriptions")
}

// 支付方式
enum PayMethod {
  stripe
  wechat
  alipay
}

// 订单状态
enum OrderStatus {
  pending
  paid
  failed
  refunded
}

// 订单表
model Order {
  id            String           @id @default(cuid())
  userId        String
  plan          SubscriptionPlan
  amount        Int // 金额（分）
  currency      String           @default("usd") // 货币单位
  payMethod     PayMethod?
  status        OrderStatus      @default(pending)
  outTradeNo    String           @unique // 商户订单号
  transactionId String?          @unique // 支付平台交易号（唯一约束防重复写入）
  paidAt        DateTime?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("orders")
}

// 使用配额表（每日限制）
model UsageQuota {
  id               String @id @default(cuid())
  userId           String
  date             String // YYYY-MM-DD
  baziAiCount      Int    @default(0) // 八字 AI 解读使用次数
  tarotSingleCount Int    @default(0) // 塔罗单张牌使用次数
  tarotThreeCount  Int    @default(0) // 塔罗三张牌使用次数

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("usage_quotas")
}

// 密码重置 Token
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// 塔罗占卜记录
model TarotReading {
  id        String  @id @default(cuid())
  userId    String?
  question  String?
  spread    String // single, three, celtic
  cards     Json // 抽到的牌
  aiReading String  @db.Text

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([userId, createdAt])
  @@map("tarot_readings")
}

// 音乐运势签记录
model MusicOracleRecord {
  id          String   @id @default(cuid())
  userId      String?  // 登录用户ID，游客为null
  sessionId   String?  // 会话ID（游客追踪用）
  question    String   // 用户输入的问题
  birthYear   Int?     // 出生年份（可选）
  ganzhi      String   // 求签时的今日干支
  wuxing      String   // 今日天干五行
  userWuxing  String?  // 用户日主五行
  songName    String   // 推荐歌名
  artist      String   // 歌手
  lyricsQuote String   // 歌词金句
  oracleText  String   @db.Text // AI签文全文
  musicTags   Json     @default("[]") // 音乐风格标签
  wuxingNote  String?  // 五行简析
  shareCount  Int      @default(0)  // 分享次数

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@map("music_oracle_records")
}

// 每日运势详细分析记录
model DailyDetailHistory {
  id          String   @id @default(cuid())
  userId      String
  date        String   // YYYY-MM-DD
  summary     String?  @db.Text  // 综述段（用于历史列表展示）
  fullContent String?  @db.Text  // 完整 4 段内容（Markdown）
  llmModel    String?  // 使用的模型名
  generatedAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_detail_history")
}
