// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?

  // 微信登录
  wechatOpenId  String? @unique
  wechatUnionId String?

  // Stripe 客户号（M6: 避免 listByEmail 选错 customer）
  stripeCustomerId String? @unique

  // 用户信息
  nickname String?
  avatar   String?

  // 出生信息（用于命理计算）
  birthDate String? // YYYY-MM-DD
  birthHour String? // 时辰 "-1" to "11"
  gender    String? // male/female

  // 时间戳
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  passwordChangedAt DateTime?

  // 关联
  accounts      Account[]
  sessions      Session[]
  subscriptions Subscription[]
  orders        Order[]
  usageQuotas   UsageQuota[]
  baziProfiles  BaziProfile[]

  @@map("users")
}

// 八字档案表（多人命盘）
model BaziProfile {
  id         String   @id @default(cuid())
  userId     String
  label      String   // 显示名，如"妈妈"
  name       String   // 真实姓名
  gender     String   // "male" | "female"
  birthDate  String   // YYYY-MM-DD（阳历）
  birthHour  String   // "-1" to "11"
  birthPlace String?
  isLunar    Boolean  @default(false)
  isPrimary  Boolean  @default(false) // 本人主档案
  baziResult Json? // 缓存的命盘结果（BaziApiResult JSON）
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("bazi_profiles")
}

// NextAuth Account 表（OAuth 账号关联）
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

// NextAuth Session 表
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

// NextAuth 验证 Token
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// 订阅计划类型
enum SubscriptionPlan {
  daily
  yearly
  lifetime
}

// 订阅状态
enum SubscriptionStatus {
  active
  expired
  cancelled
}

// 订阅表
model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  plan               SubscriptionPlan
  status             SubscriptionStatus @default(active)
  startAt            DateTime           @default(now())
  expireAt           DateTime
  autoRenew          Boolean            @default(false)
  cancelAtPeriodEnd  Boolean            @default(false)
  pendingPlan        SubscriptionPlan?
  pendingPlanDate    DateTime?
  paymentMethod      PayMethod?
  paymentMethodLast4 String?
  cancelFeedback     String?
  cancelledAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expireAt])
  @@index([userId, createdAt])
  @@map("subscriptions")
}

// 支付方式
enum PayMethod {
  stripe
  wechat
  alipay
}

// 订单状态
enum OrderStatus {
  pending
  paid
  failed
  refunded
}

// 订单表
model Order {
  id            String           @id @default(cuid())
  userId        String
  plan          SubscriptionPlan
  amount        Int // 金额（分）
  currency      String           @default("usd") // 货币单位
  payMethod     PayMethod?
  status        OrderStatus      @default(pending)
  outTradeNo    String           @unique // 商户订单号
  transactionId String?          @unique // 支付平台交易号（唯一约束防重复写入）
  paidAt        DateTime?
  deletedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@map("orders")
}

// 使用配额表（每日限制）
model UsageQuota {
  id                String @id @default(cuid())
  userId            String
  date              String // YYYY-MM-DD
  baziAiCount       Int    @default(0) // 八字 AI 解读使用次数
  tarotSingleCount  Int    @default(0) // 塔罗单张牌使用次数
  tarotThreeCount   Int    @default(0) // 塔罗三张牌使用次数
  liuyaoCount       Int    @default(0) // 六爻 AI 解读使用次数
  meihuaDecideCount Int    @default(0) // 梅花决策 AI 使用次数
  dailyCount        Int    @default(0) // 每日运势 AI 使用次数
  // —— 统一配额策略 v1 新增（免费用户主解读/问答各 1 次/天）——
  huangliCount      Int    @default(0) // 黄历 AI 问答
  musicCount        Int    @default(0) // 音乐运势签
  marriageCount     Int    @default(0) // 合婚 AI（独立额度，不再共享八字）
  meihuaDrawCount   Int    @default(0) // 梅花起卦 AI 解读
  dailyQaCount      Int    @default(0) // 每日运势问答
  liuyaoQaCount     Int    @default(0) // 六爻问答
  meihuaQaCount     Int    @default(0) // 梅花问答
  marriageQaCount   Int    @default(0) // 合婚问答

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("usage_quotas")
}

// 密码重置 Token
model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("password_reset_tokens")
}

// 塔罗占卜记录
model TarotReading {
  id        String  @id @default(cuid())
  userId    String?
  question  String?
  spread    String // single, three, celtic
  cards     Json // 抽到的牌
  aiReading String  @db.Text

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([userId, createdAt])
  @@map("tarot_readings")
}

// 音乐运势签记录
model MusicOracleRecord {
  id          String   @id @default(cuid())
  userId      String?  // 登录用户ID，游客为null
  sessionId   String?  // 会话ID（游客追踪用）
  question    String   // 用户输入的问题
  birthYear   Int?     // 出生年份（可选）
  ganzhi      String   // 求签时的今日干支
  wuxing      String   // 今日天干五行
  userWuxing  String?  // 用户日主五行
  songName    String   // 推荐歌名
  artist      String   // 歌手
  lyricsQuote String   // 歌词金句
  oracleText  String   @db.Text // AI签文全文
  musicTags   Json     @default("[]") // 音乐风格标签
  wuxingNote  String?  // 五行简析
  shareCount  Int      @default(0)  // 分享次数

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([sessionId, createdAt])
  @@map("music_oracle_records")
}

// 每日运势详细分析记录
model DailyDetailHistory {
  id          String   @id @default(cuid())
  userId      String
  date        String   // YYYY-MM-DD
  summary     String?  @db.Text  // 综述段（用于历史列表展示）
  fullContent String?  @db.Text  // 完整 4 段内容（Markdown）
  llmModel    String?  // 使用的模型名
  generatedAt DateTime @default(now())

  @@unique([userId, date])
  @@index([userId])
  @@map("daily_detail_history")
}

// AI 运势问答历史
model DailyFortuneQaHistory {
  id        String   @id @default(cuid())
  userId    String
  question  String   @db.Text
  answer    String?  @db.Text
  llmModel  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("daily_fortune_qa_history")
}

// 人生K线回测投票（PRD-LIFE-KLINE-V2 P0-A：「准」占比是传播推广的护栏指标）
model KlineBacktestVote {
  id        String   @id @default(cuid())
  userId    String
  birthHash String   // sha256(出生信息) 截断，同一用户同一命盘同一年份唯一
  year      Int      // 被投票的公历年
  age       Int      // 当年虚岁
  score     Int      // 当年收盘运势分
  level     String   // 等级：极盛/上佳/平稳/承压/低谷
  kind      String   // peak（高分年）| trough（低分年）
  vote      String   // yes（准）| no（不准）
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, birthHash, year])
  @@index([createdAt])
  @@map("kline_backtest_votes")
}

// 换大运提醒意向（PRD-LIFE-KLINE-V2 P2-B：V2 仅落库意向，通道 V2.1 选型后触达）
model KlineRemindIntent {
  id          String   @id @default(cuid())
  userId      String
  birthHash   String   // 与回测投票同规则的命盘哈希
  targetYear  Int      // 换运公历年
  dayunGanZhi String   // 下一步大运干支，如 "甲午"
  createdAt   DateTime @default(now())

  @@unique([userId, birthHash, targetYear])
  @@index([targetYear])
  @@map("kline_remind_intents")
}
